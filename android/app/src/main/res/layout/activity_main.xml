<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    tools:context=".MainActivity">

    <!-- Top App Bar (Dominant White with Orange Accent) -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <!-- Logo Orange Icon -->
            <androidx.cardview.widget.CardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardCornerRadius="10dp"
                app:cardBackgroundColor="@color/orange_primary"
                app:cardElevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🛡️"
                    android:textSize="18sp" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KitchenGuard CSM"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality Control &amp; Waste AI"
                    android:textColor="@color/orange_primary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Status Pill -->
            <TextView
                android:id="@+id/tvAiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● AI ONLINE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/orange_primary"
                android:background="@color/orange_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="64dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Mode Selector Chips (Orange Active, White Surface) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipVision"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="🥩 Scan Bahan"
                        app:chipBackgroundColor="@color/white"
                        app:chipStrokeColor="@color/orange_primary"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBarcode"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏷️ Scan Barcode"
                        app:chipBackgroundColor="@color/white"
                        android:textColor="@color/text_muted" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipScale"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚖️ Timbangan"
                        app:chipBackgroundColor="@color/white"
                        android:textColor="@color/text_muted" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLog"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Log Waste"
                        app:chipBackgroundColor="@color/white"
                        android:textColor="@color/text_muted" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Camera Viewfinder Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#0F172A"
                android:layout_marginBottom="14dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Camera Preview View (CameraX) -->
                    <androidx.camera.view.PreviewView
                        android:id="@+id/previewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Overlay Brackets & Laser -->
                    <View
                        android:layout_width="190dp"
                        android:layout_height="140dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/scanner_brackets" />

                    <!-- Hud Hint Text -->
                    <TextView
                        android:id="@+id/tvCameraHud"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="12dp"
                        android:text="Arahkan ke bahan makanan (Daging, Buah, Sayur)"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:background="#CC0F172A"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Action Test Presets (Daging, Buah, Sayur, Seafood) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PILIH SAMPEL BAHAN (VISION AI):"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:layout_marginBottom="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSampleBeef"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="🥩 Daging Sapi"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_color"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSampleChicken"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="🍗 Daging Ayam"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_color"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSampleApple"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="4dp"
                    android:text="🍎 Apel Fuji"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_color"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSampleTomato"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="4dp"
                    android:text="🍅 Tomat Ceri"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_color"
                    app:cornerRadius="10dp" />
            </GridLayout>

            <!-- Result CardView (Dominant White with Orange Accent) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color"
                app:strokeWidth="1dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Top Orange Accent Line -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:background="@color/orange_primary"
                        android:layout_marginBottom="12dp" />

                    <!-- Header Row: Title & Confidence -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvFreshnessBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="FRESH"
                                android:textStyle="bold"
                                android:textColor="@color/green_fresh"
                                android:background="@color/green_fresh_bg"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvIngredientTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daging Sapi (Tenderloin)"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp" />

                            <TextView
                                android:id="@+id/tvCategorySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Daging &amp; Unggas • Chiller 0°C - 2°C"
                                android:textColor="@color/orange_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="end">

                            <TextView
                                android:id="@+id/tvConfidence"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="96.4%"
                                android:textColor="@color/orange_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvGateStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ GATE APPROVED"
                                android:textColor="@color/green_fresh"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Meta Rows -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_light"
                        android:layout_marginVertical="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Berat Timbangan (OCR)"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvWeightValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.45 kg"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Batch / Expired"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvBatchValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WG-0915-A (22 Sep 2026)"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- SOP Recommendation Alert -->
                    <TextView
                        android:id="@+id/tvSopAction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rekomendasi SOP: KONDISI PRIMA! Simpan di chiller dengan rotasi FIFO."
                        android:textColor="@color/orange_dark"
                        android:background="@color/orange_light"
                        android:padding="10dp"
                        android:textSize="12sp"
                        android:layout_marginTop="12dp" />

                    <!-- Primary Save Action Button (Vibrant Orange) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitLog"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="💾 Simpan ke Log Waste Android"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/orange_primary"
                        app:cornerRadius="12dp"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar (Dominant White with Orange Active Item) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/orange_primary"
        app:itemTextColor="@color/orange_primary"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
